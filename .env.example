# Copy to .env and fill in your own values. .env is gitignored.
# Postgres (Render, Neon, Supabase, local) — omit to use the local SQLite file.
POS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Optional hardening
POS_SECRET_KEY=change-me-in-production
POS_COOKIE_SECURE=false
POS_SEED_DEMO=true

# Connection pool (optional). LIFO keeps the busiest connection warm.
POS_DB_POOL_SIZE=5
POS_DB_MAX_OVERFLOW=10
POS_DB_POOL_TIMEOUT=30
POS_DB_CONNECT_TIMEOUT=10
POS_DB_POOL_USE_LIFO=true
POS_DB_APP_NAME=universal-pos

# WhatsApp Cloud API (daily 6pm executive summary)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
POS_DAILY_REPORT_SCHEDULER=false   # true on Render (the web worker checks every 2 minutes)
POS_DAILY_REPORT_HOUR=18
# Set true locally to log messages instead of sending them.
POS_WHATSAPP_DRY_RUN=false
